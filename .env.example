# Application
APP_ENV=development
PORT=3000
API_PORT=4000
PUBLIC_BASE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api/v1
CORS_ORIGINS=http://127.0.0.1:3000

# API
# Server-side web proxy target. Railway should use the API private-network origin.
API_INTERNAL_URL=http://127.0.0.1:4000
SESSION_HOURS=12
SECURE_COOKIES=false

# Database
DATABASE_URL=postgresql://ward_ops:ward_ops@localhost:5432/ward_ops
TEST_DATABASE_URL=postgresql://ward_ops:ward_ops@localhost:5433/ward_ops_test
POSTGRES_PASSWORD=ward_ops

# Object storage (S3-compatible)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=ward-ops-evidence
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Owner setup
OWNER_SETUP_TOKEN=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=System Administrator

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=mazingira-ops@example.go.ke

# AI (optional)
AI_ENABLED=false
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.1-8b-instant

# Uploads
MAX_UPLOAD_BYTES=5242880
# Local (dev/test) object-storage directory. Keep distinct from the legacy
# evidence root (data/documents) so reconciliation does not mix the two.
DOCUMENT_STORE_DIR=data/objects
