{
  "name": "@ward-ops/api",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.json && node --watch dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "pnpm build && vitest run --config vitest.integration.config.ts",
    "migrate:legacy": "tsx src/migration/cli.ts",
    "lint": "echo \"(lint runs from workspace root)\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^9.4.0",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "@ward-ops/contracts": "workspace:*",
    "@ward-ops/database": "workspace:*",
    "@ward-ops/validation": "workspace:*",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.1",
    "nodemailer": "^9.0.6",
    "redis": "6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.1",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
