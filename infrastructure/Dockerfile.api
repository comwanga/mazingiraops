# Multi-stage build for the NestJS API.
FROM node:24-bookworm-slim AS build
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@8.15.9 --activate
WORKDIR /app

COPY . .
RUN pnpm install --frozen-lockfile

# Prisma generate needs a URL to satisfy schema env resolution at build time;
# the value is not used (no connection is made during generate).
ENV DATABASE_URL=postgresql://build:build@localhost:5432/build
RUN pnpm db:generate \
  && pnpm --filter @ward-ops/contracts build \
  && pnpm --filter @ward-ops/validation build \
  && pnpm --filter @ward-ops/database build \
  && pnpm --filter @ward-ops/api build

FROM node:24-bookworm-slim AS runtime
RUN corepack enable \
  && corepack prepare pnpm@8.15.9 --activate \
  && apt-get update \
  && apt-get install -y --no-install-recommends openssl postgresql-client \
  && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
ENV SECURE_COOKIES=true
WORKDIR /app
COPY --from=build /app ./
USER node
EXPOSE 4000
CMD ["sh", "-c", "if [ -n \"$DATABASE_URL\" ]; then pnpm db:deploy && node packages/database/dist/seed.js; fi && exec node apps/api/dist/main.js"]
