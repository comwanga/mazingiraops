# Multi-stage build for the Next.js web app (standalone output).
FROM node:24-bookworm-slim AS build
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@8.15.9 --activate
WORKDIR /app

COPY . .
RUN pnpm install --frozen-lockfile

ENV DATABASE_URL=postgresql://build:build@localhost:5432/build
RUN pnpm db:generate \
  && pnpm --filter @ward-ops/contracts build \
  && pnpm --filter @ward-ops/validation build \
  && pnpm --filter @ward-ops/web build

FROM node:24-bookworm-slim AS runtime
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
ENV APP_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
WORKDIR /app
# Run the Next.js standalone server output. Static assets and public files are
# not bundled into the standalone directory, so copy them alongside it.
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
# Next.js needs a writable image-optimizer cache at runtime; the container runs
# as the unprivileged "node" user, so create the cache dir with node ownership.
RUN mkdir -p ./apps/web/.next/cache/images \
  && chown -R node:node /app
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
